# Next.js build output / caches (never committed)
/.next/
/out/
/build
*.tsbuildinfo

# NOTE: next-env.d.ts IS committed (Next convention) so CI `tsc --noEmit` has the
# Next ambient types without first running a build.

# Vercel
.vercel

# Env files (secrets — never committed; Amplify/Vercel inject these)
.env*
!.env.example

# Debug logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
